    "type": "object",
    "required": [
     "text"
    ],
    "title": "DetectLLMRequest"
   },
   "DetectOptions": {
    "properties": {
     "llm": {
      "type": "boolean",
      "title": "Llm",
      "description": "Run the LLM pass. False = rule pass only, meta.model='none'.",
      "default": true
     },
     "model": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Model",
      "description": "Override the Ollama model for this request."
     },
     "retries": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 10.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Retries",
      "description": "Override the repair-loop retry budget."
     }
    },
    "type": "object",
    "title": "DetectOptions"
   },
   "DetectRequest": {
    "properties": {
     "doc_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Doc Id"
     },
     "text": {
      "type": "string",
      "title": "Text"
     },
     "options": {
      "$ref": "#/components/schemas/DetectOptions"
     }
    },
    "type": "object",
    "required": [
     "text"
    ],
    "title": "DetectRequest"
   },
   "DetectRulesRequest": {
    "properties": {
     "doc_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Doc Id"
     },
     "text": {
      "type": "string",
      "title": "Text"
