 "components": {
  "schemas": {
   "Action": {
    "type": "string",
    "enum": [
     "placeholder",
     "generalise",
     "keep"
    ],
    "title": "Action"
   },
   "AttackDefinition": {
    "properties": {
     "attack_id": {
      "type": "string",
      "title": "Attack Id"
     },
     "kind": {
      "type": "string",
      "enum": [
       "direct",
       "linkage",
       "stepwise"
      ],
      "title": "Kind"
     },
     "name": {
      "type": "string",
      "title": "Name"
     },
     "target_person_id": {
      "type": "string",
      "title": "Target Person Id"
     },
     "queries": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "minItems": 1,
      "title": "Queries"
     }
    },
    "type": "object",
    "required": [
     "attack_id",
     "kind",
     "name",
     "target_person_id",
     "queries"
    ],
    "title": "AttackDefinition",
    "description": "One file in data/attacks/ (plan 6.3)."
   },
   "AttackRound": {
    "properties": {
     "round": {
      "type": "integer",
      "title": "Round"
     },
     "query": {
      "type": "string",
      "title": "Query"
     },
     "baseline": {
      "$ref": "#/components/schemas/RagAnswer"
     },
     "protected": {
      "$ref": "#/components/schemas/RagAnswer"
     },
     "baseline_leakage": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/RoundLeakage"
       },
       {
        "type": "null"
       }
      ]
     },
     "protected_leakage": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/RoundLeakage"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "type": "object",
    "required": [
     "round",
     "query",
     "baseline",
     "protected"
    ],
    "title": "AttackRound"
   },
   "AttackRun": {
    "properties": {
     "attack_id": {
      "type": "string",
      "title": "Attack Id"
     },
     "session_id": {
      "type": "string",
      "title": "Session Id"
     },
     "rounds": {
      "items": {
       "$ref": "#/components/schemas/AttackRound"
      },
      "type": "array",
      "title": "Rounds"
     },
     "baseline_identified_at": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Baseline Identified At"
     },
     "protected_identified_at": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Protected Identified At"
     }
    },
    "type": "object",
    "required": [
     "attack_id",
     "session_id",
     "rounds"
    ],
    "title": "AttackRun"
   },
   "AttackRunRequest": {
    "properties": {
     "session_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Session Id"
     }
    },
    "type": "object",
    "title": "AttackRunRequest"
   },
   "CompareRequest": {
    "properties": {
     "query": {
      "type": "string",
      "minLength": 1,
      "title": "Query"
     },
     "session_id": {
      "type": "string",
      "title": "Session Id"
     },
     "k": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 20.0,
        "minimum": 1.0
       },
       {
        "type": "null"
       }
      ],
      "title": "K"
     }
    },
    "type": "object",
    "required": [
     "query",
     "session_id"
    ],
    "title": "CompareRequest"
   },
   "CompareResponse": {
    "properties": {
     "baseline": {
      "$ref": "#/components/schemas/RagAnswer"
     },
     "protected": {
      "$ref": "#/components/schemas/RagAnswer"
     }
    },
    "type": "object",
    "required": [
     "baseline",
     "protected"
    ],
    "title": "CompareResponse"
   },
