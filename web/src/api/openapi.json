     },
     "llm_ms": {
      "type": "integer",
      "title": "Llm Ms"
     },
     "total_ms": {
      "type": "integer",
      "title": "Total Ms"
     },
     "retries": {
      "type": "integer",
      "title": "Retries"
     },
     "rule_span_count": {
      "type": "integer",
