     },
     "output": {
      "$ref": "#/components/schemas/DetectorOutput"
     },
     "meta": {
      "$ref": "#/components/schemas/DetectorMeta"
     }
    },
    "type": "object",
    "required": [
     "doc_id",
     "original_sha256",
     "output",
     "meta"
    ],
    "title": "DetectorResult"
   },
   "DocumentSummary": {
    "properties": {
     "doc_id": {
      "type": "string",
      "title": "Doc Id"
     },
     "preview": {
      "type": "string",
