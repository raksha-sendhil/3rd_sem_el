# Copy to .env and adjust. Every key is optional; defaults live in src/sanitise/config.py.
# All keys are prefixed with SANITISE_.

# ---- LLM backend: "ollama" or "gemini" for a real model, "mock" for MockLLM (no model needed).
# config/domains.json can set it per domain: on this branch the legal domain uses "gemini".
SANITISE_LLM_BACKEND=ollama
SANITISE_OLLAMA_BASE_URL=http://localhost:11434
SANITISE_MODEL=llama3:8b
SANITISE_FALLBACK_MODEL=qwen2.5:7b-instruct
SANITISE_LLM_TIMEOUT_S=120
SANITISE_LLM_NUM_CTX=4096
SANITISE_LLM_SEED=42
SANITISE_LLM_NUM_PREDICT=1024

# ---- Validation retry loop (spec 3.1, stage 5)
SANITISE_LLM_RETRIES=3
SANITISE_LLM_TEMPERATURE=0.0
SANITISE_LLM_TEMPERATURE_STEP=0.2
SANITISE_LLM_TEMPERATURE_MAX=1.0
SANITISE_TRANSPORT_RETRIES=1

# ---- Document load (spec 3.1, stage 1)
SANITISE_MAX_DOC_CHARS=2000
SANITISE_CHATDOCTOR_INCLUDE_ANSWER=false

# ---- Session privacy monitor (legal build spec, step 12): off | candidate_pool
SANITISE_MONITOR=candidate_pool
SANITISE_MONITOR_MIN_POOL=5
SANITISE_CLIENTS_PATH=data/legal/clients.json

# ---- Legal build spec: domain and models (docs/legal/README.md)
# The default domain (a request can choose another with ?domain=). Each domain's models and
# data are set in config/domains.json; the settings below are the fallbacks for null fields.
SANITISE_DOMAIN=legal
SANITISE_DOMAINS_FILE=config/domains.json
# Answering model: same (the agents' model) | gemini | ollama | mock
SANITISE_ANSWER_BACKEND=same
SANITISE_GEMINI_MODEL=gemini-3.5-flash
# Read from GEMINI_API_KEY (or the Kaggle secret of that name) when empty. Never commit a key.
SANITISE_GEMINI_API_KEY=
# Several keys, rotated when one is rate-limited or out of quota (or use GEMINI_API_KEY,
# GEMINI_API_KEY_2 ... GEMINI_API_KEY_9). docs/legal/kaggle_steps.md, section 6.
SANITISE_GEMINI_API_KEYS=
SANITISE_GEMINI_KEY_COOLDOWN_S=60
# Tokens per key per day before the next key is used; 0 = no budget
SANITISE_GEMINI_DAILY_TOKEN_BUDGET=0
# When every key is resting for at most this long, wait instead of failing the document.
SANITISE_GEMINI_MAX_KEY_WAIT_S=300
SANITISE_GEMINI_CACHE_DIR=data/cache/gemini
SANITISE_GEMINI_RPM=10
# Agent 1's LLM pass: same | transformers (Gemma 4 + the fine-tuned LoRA adapter)
SANITISE_AGENT1_BACKEND=same
SANITISE_AGENT1_BASE_MODEL=google/gemma-4-E4B-it
SANITISE_AGENT1_ADAPTER=
SANITISE_AGENT1_DEVICE=cuda:1
# Replay an exported Kaggle run in the dashboard (python -m sanitise.legal export)
SANITISE_REPLAY_DIR=

# ---- HTTP API
SANITISE_API_HOST=127.0.0.1
SANITISE_API_PORT=8000

SANITISE_LOG_LEVEL=INFO
